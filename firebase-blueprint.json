  "firestore": {
    "/players/{userId}": {
      "schema": { "$ref": "#/entities/PlayerProfile" },
      "description": "Public Arena player profile documents (zero PII)."
    },
    "/players/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/PlayerPrivateAccount" },
      "description": "Owner-only private account documents containing email PII."
    },
    "/players/{userId}/cards/{cardId}": {
      "schema": { "$ref": "#/entities/PlayerCard" },
      "description": "Owner-scoped cloud champion cards and Phase 3 progression state."
    },
    "/players/{userId}/matches/{matchId}": {
      "schema": { "$ref": "#/entities/MatchRecord" },
      "description": "Owner-scoped immutable match history records."
    },
    "/rooms/{roomId}": {
      "schema": { "$ref": "#/entities/BattleRoom" },
      "description": "Real-time 5v5 PvP multiplayer rooms."
    },
    "/rooms/{roomId}/moves/{moveId}": {
      "schema": { "$ref": "#/entities/RoomMove" },
      "description": "Immutable turn-by-turn move ledger synced atomically with BattleRoom updates."
    },
    "/wallets/{userId}": {
      "schema": { "$ref": "#/entities/PlayerWallet" },
      "description": "Oracle Shards virtual currency balance with ledger-verified settlements."
    },
    "/tradableCards/{cardId}": {
      "schema": { "$ref": "#/entities/TradableCard" },
      "description": "Canonical single-owner verified registry for minted custom Oracle cards."
    },
    "/marketplaceListings/{listingId}": {
      "schema": { "$ref": "#/entities/MarketplaceListing" },
      "description": "Marketplace listings for verified custom Oracle cards."
    },
    "/marketplaceListings/{listingId}/offers/{offerId}": {
      "schema": { "$ref": "#/entities/MarketplaceOffer" },
      "description": "Buyer offers submitted on active Marketplace listings."
    },
    "/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/TradeProposal" },
      "description": "Direct player-to-player card trade proposals and counteroffers."
    },
    "/ownershipLedger/{transferId}": {
      "schema": { "$ref": "#/entities/OwnershipTransferRecord" },
      "description": "Immutable public provenance ledger for verified Marketplace sales and Trades."
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Player-to-player friend requests and accepted friendships."
    },
    "/clans/{clanId}": {
      "schema": { "$ref": "#/entities/Clan" },
      "description": "Player clans with emblem, tag, join policy, leadership, and aggregate stats."
    },
    "/clans/{clanId}/members/{memberUid}": {
      "schema": { "$ref": "#/entities/ClanMember" },
      "description": "Subcollection of verified clan members and their RBAC roles (leader/officer/member)."
    },
    "/clans/{clanId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ClanMessage" },
      "description": "Clan warroom chat, announcements, and PvP spar room code callouts."
    },
    "/clanMemberships/{userId}": {
      "schema": { "$ref": "#/entities/ClanMembership" },
      "description": "Canonical single-clan pointer per player UID for profile badges and 1-clan enforcement."
    },
    "/clanInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/ClanInvite" },
      "description": "Direct recruitment invitations sent by clan leaders or officers."
    }
  }
}
